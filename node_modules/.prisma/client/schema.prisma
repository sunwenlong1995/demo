generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Shipment {
  id              String   @id @default(cuid())
  externalCode    String?  @unique(map: "external_code_unique")
  senderName      String
  senderPhone     String
  senderAddress   String
  receiverName    String
  receiverPhone   String
  receiverAddress String
  weight          Float
  quantity        Int
  temperature     String
  remark          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
